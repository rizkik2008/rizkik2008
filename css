:root {
  --bg: #e9eef0;
  --ink: #1b2a2f;
  --muted: #5d6e74;
  --line: #d5dee1;
  --accent: #0f6e6e;
  --soft: #e0f0ef;
}

* { box-sizing: border-box; margin: 0; padding: 0; }

body {
  font-family: "Segoe UI", system-ui, Arial, sans-serif;
  background: var(--bg);
  color: var(--ink);
  line-height: 1.6;
  padding: 24px 16px;
}

.cv {
  max-width: 720px;
  margin: 0 auto;
  background: #fff;
  border-radius: 14px;
  overflow: hidden;
  box-shadow: 0 6px 24px rgba(15, 50, 55, 0.12);
}

header { background: var(--accent); color: #fff; padding: 32px; }
header h1 { font-size: 1.9rem; line-height: 1.2; }
header p { margin-top: 4px; }

.info {
  margin-top: 14px;
  display: flex;
  flex-wrap: wrap;
  gap: 4px 16px;
  font-size: 0.92rem;
}

section { padding: 20px 32px; border-bottom: 1px solid var(--line); }
h2 { font-size: 1.1rem; color: var(--accent); margin-bottom: 8px; }
h3 { font-size: 1rem; }
.muted { color: var(--muted); font-size: 0.93rem; }

.tags { display: flex; flex-wrap: wrap; gap: 10px; }

.tags span,
.tags a {
  padding: 6px 16px;
  border-radius: 999px;
  font-weight: 600;
  font-size: 0.95rem;
  text-decoration: none;
}

.tags span { background: var(--soft); color: var(--accent); }
.tags a { border: 1.5px solid var(--accent); color: var(--accent); }
.tags a:hover,
.tags a:focus-visible { background: var(--accent); color: #fff; }

footer { text-align: center; padding: 14px; font-size: 0.85rem; color: var(--muted); }

@media (max-width: 520px) {
  header, section { padding: 18px 20px; }
}
